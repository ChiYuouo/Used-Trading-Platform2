            {
              "_type": "UMLNoteView",
              "_id": "C2CS000609",
              "_parent": {
                "$ref": "C2CS000530"
              },
              "font": "Microsoft YaHei;12;0",
              "left": 30,
              "top": 630,
              "width": 1160,
              "height": 90,
              "text": "按当前 application.yml 配置，Spring Boot 内嵌 Tomcat(:8080)、MySQL(:3306) 和图片目录(D:/toImage)在同一主机。MyWebAppConfigurer 自动映射 /toImage/** 与静态资源；数据库连接池默认使用 HikariCP。邮件发送与图片审核调用已注释，未作为运行中的外部网络节点绘制。",
              "wordWrap": true,
              "fillColor": "#FFFDE7"
            }
          ],
